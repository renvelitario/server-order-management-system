# The port the Express server will attach to
PORT=5000

# The runtime environment context (development | production)
NODE_ENV=development

# Postgres database connection string (Supabase provides this inside Database settings).
# Be sure to append `?pgbouncer=true` if using Supabase's IPv4 connection pooling.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# The URL of your Supabase project (Found in Project Settings > API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Your Supabase public 'anon' key 
# (Used securely on the backend for supplementary verifications matching the client config)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Your Supabase 'service_role' admin key (Used securely on the backend to completely bypass Row-Level Security).
# ⚠️ SECURITY WARNING: NEVER expose this to the frontend or commit it anywhere!
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# A comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS).
# Usually http://localhost:5173 for local Vite execution.
CORS_ORIGINS=http://localhost:5173
